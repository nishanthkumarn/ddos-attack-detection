from __future__ import annotations

import asyncio
import ipaddress
import random
import time
import uuid
from collections import deque
from datetime import datetime, timezone

try:
    from river import metrics
except ImportError:
    metrics = None

from .config import settings
from .db import insert_event, upsert_alert
from .drift import DriftMonitor
from .metrics import EVENTS, ALERTS, INFERENCE, STREAM_EVENTS, WS_CLIENTS, DRIFT
from .model import detector
from .schemas import FlowEvent

clients: set = set()
rng = random.Random(settings.random_seed)
latency_ms = deque(maxlen=500)
accuracy = metrics.Accuracy() if metrics else None
stream_state = {"running": True, "interval_ms": settings.demo_interval_ms, "events": 0, "attack_burst": False,
                "source": "synthetic", "last_event_at": None}
drift = DriftMonitor(settings.drift_window, settings.drift_z_threshold)


def synthetic_features():
    burst = stream_state["attack_burst"]
    attack = rng.random() < (0.72 if burst else 0.25)
    if attack:
        pps = rng.uniform(12000, 95000); bps = pps * rng.uniform(400, 1500); duration = rng.uniform(5, 1400)
        syn = rng.uniform(0.5, 1.0); dst_port = rng.choice([53, 80, 443, 123, 1900])
    else:
        pps = rng.uniform(15, 2500); bps = pps * rng.uniform(180, 1300); duration = rng.uniform(50, 180000)
        syn = rng.uniform(0, 0.35); dst_port = rng.choice([22, 53, 80, 443, 3389])
    return {"pps": pps, "bps": bps, "Flow Packets/s": pps, "Flow Bytes/s": bps, "Flow Duration": duration,
            "Total Fwd Packets": max(1, pps * duration / 1000 * 0.55),
            "Total Backward Packets": max(1, pps * duration / 1000 * 0.45),
            "Destination Port": dst_port, "SYN Flag Count": syn * 100,
            "Fwd Packet Length Mean": rng.uniform(40, 1400)}, attack


def make_event():
    f, truth = synthetic_features()
    started = time.perf_counter()
    label, p, conf, severity, signals, mode = detector.predict(f)
    elapsed = time.perf_counter() - started
    INFERENCE.observe(elapsed)
    latency_ms.append(elapsed * 1000)
    drift_signals = drift.update(f, detector.feature_stats)
    signals += [{"feature": x["feature"], "importance": 0.0, "value": x["value"], "drift_z": x["z_score"]} for x in drift_signals]
    if mode == "demo" and accuracy:
        accuracy.update(truth, label == "DDoS")
    src = str(ipaddress.IPv4Address(rng.randrange(0x0A000001, 0x0AFFFFFF)))
    dst = "10.0.0.10"
    event = FlowEvent(event_id=uuid.uuid4().hex, timestamp=datetime.now(timezone.utc), src_ip=src, dst_ip=dst,
        src_port=rng.randrange(1024, 65535), dst_port=int(f["Destination Port"]), protocol=rng.choice(["TCP", "UDP"]),
        label=label, probability=p, confidence=conf, severity=severity, bytes_per_second=f["bps"],
        packets_per_second=f["pps"], flow_duration_ms=f["Flow Duration"], mode=mode,
        model_version=detector.version, features=f, top_signals=signals)
    return event, truth


async def broadcast_event(event: FlowEvent):
    WS_CLIENTS.set(len(clients))
    payload = event.model_dump(mode="json")
    dead = []
    for ws in list(clients):
        try:
            await ws.send_json(payload)
        except Exception:
            dead.append(ws)
    for ws in dead:
        clients.discard(ws)


async def stream_loop(stop_event):
    while not stop_event.is_set():
        if stream_state["running"]:
            event, _truth = make_event()
            insert_event(event)
            alert_id = upsert_alert(event)
            stream_state["events"] += 1
            stream_state["last_event_at"] = event.timestamp.isoformat()
            STREAM_EVENTS.set(stream_state["events"])
            EVENTS.labels(event.label, event.mode).inc()
            DRIFT.set(drift.snapshot()["anomaly_rate"])
            if alert_id:
                ALERTS.labels(event.severity).inc()
            await broadcast_event(event)
        await asyncio.sleep(stream_state["interval_ms"] / 1000)
